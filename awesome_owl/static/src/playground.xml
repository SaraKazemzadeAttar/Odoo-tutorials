<?xml version="1.0" ?>

<templates xml:space="preserve">

<t t-name="awesome_owl.playground">
	<!--	  <Card title="'Card 1'" content="value1"/>-->
	<!--	  <Card title="'Card 2'" content="value2"/>-->
	<!--	  <Card title="'Card 3'" content="'This is the first card'"/>-->
	<div class="container my-4">
     <Card title="' TODO list'">

        <div class="mb-3">
	        <Card title="'Card A: '">
		       <input t-ref="inputTodo" type="text" placeholder="Enter a new task" t-on-keyup="addTodo" class="form-control mb-3"/>
		        <t t-foreach="todos" t-as="todo" t-key="todo.id">
              <TodoItem todo="todo" toggleState.bind="toggleState" removeTodo.bind="removeTodo"/>
            </t>
          </Card>

	        <Card title="'Card B: '">
	                    <Counter onChange.bind="incrementSum"/>
	                  </Card>

	        <!--          <p>Total sum: <t t-esc="state.sum"/></p>-->
        </div>
      </Card>
	</div>
	<!--	  <Counter/>-->
	<!--	  <Counter/>-->

</t>
</templates>
