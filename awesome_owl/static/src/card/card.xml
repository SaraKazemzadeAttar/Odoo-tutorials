<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="awesome_owl.card">
	  <div class="card mb-3 shadow" style="width: 30rem; margin: auto;">
    <h5 class="card-header fw-bold d-flex justify-content-between align-items-center">
      <span><t t-out="props.title"/></span>
	    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="toggle">
        <t t-if="state.isOpen">Close</t>
		    <t t-else="">Open</t>
      </button>
    </h5>
		  <div class="card-body" t-if="state.isOpen">
      <t t-slot="default"/>
    </div>
  </div>
</t>
</templates>