<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'" display="{'controlPanel': {} }">
            <t t-set-slot="layout-buttons"> <!-- to put buttons on the layout -->
	            <button class="btn btn-primary" t-on-click="openCustomers">Customers</button>
	            <button class="btn btn-primary" t-on-click="openLeads">Leads</button>
	        </t>

	        <t t-slot="default">
                <div class="d-flex flex-wrap p-3">>
                    <DashboardItem size="1" >
                        <h4>Average amount of t_shirt by order this month</h4>
	                    <t t-esc="state.avg_tshirt_per_order"/>
                    </DashboardItem>

	                <DashboardItem size="1">
                        <h4>Avg Time New → Sent/Cancelled</h4>
		                <p t-esc="state.avg_processing_time"/>
                    </DashboardItem>

	                <DashboardItem size="1">
                        <h4>New Orders This Month</h4>
		                <p t-esc="state.new_orders"/>
                    </DashboardItem>

	                <DashboardItem size="1">
                        <h4>Cancelled Orders</h4>
		                <p t-esc="state.cancelled_orders"/>
                    </DashboardItem>

	                <DashboardItem size="1">
		                <h4>Total Amount of New Orders</h4>
		                <p t-esc="state.total_amount"/>
	                </DashboardItem>

	                <DashboardItem size="2">
		                <h4>Shirt orders by size</h4>
		                <PieChart data="state?.orders_by_size" label="'Shirt orders by size'"/>
                    </DashboardItem>
                </div>
            </t>

        </Layout>
    </t>
</templates>
