<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'" display="{'controlPanel': {} }">

            <t t-slot="controlPanel">
                <button type="button" class="btn btn-primary" t-on-click="openCustomers">Customers</button>
                <button type="button" class="btn btn-secondary" t-on-click="openLeads">Leads</button>
            </t>

            <t t-slot="default">
                <h1>Welcome to the Awesome Dashboard!</h1>
            </t>

        </Layout>
    </t>
</templates>
